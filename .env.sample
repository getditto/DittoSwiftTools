# DittoToolsApp credentials — copy this file to .env and fill in your values.
#
# Obtain these from the Ditto Portal: https://portal.ditto.live
# .env is gitignored; never commit real credentials.
#
# The Xcode build phase reads .env and generates DittoToolsApp/DittoToolsApp/Env.swift
# at build time. Env.swift is also gitignored.

DITTO_APP_ID=your-app-id-here
DITTO_PLAYGROUND_TOKEN=your-playground-token-here
DITTO_AUTH_URL=https://your-app-id-here.cloud.ditto.live
DITTO_WEBSOCKET_URL=wss://your-app-id-here.cloud.ditto.live